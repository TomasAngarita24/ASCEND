{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "ASCEND Node.js + Express backend API",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "tsx --test tests/auth.integration.test.ts tests/auth.cookies.integration.test.ts tests/auth-rate-limit.integration.test.ts tests/google-auth.integration.test.ts tests/exercise.integration.test.ts tests/routine.integration.test.ts tests/workout.integration.test.ts tests/cloud-sync.integration.test.ts tests/social.integration.test.ts tests/users.integration.test.ts tests/comments.integration.test.ts tests/routine-social.integration.test.ts tests/routine-template.integration.test.ts tests/progress.week-boundary.test.ts tests/progress.integration.test.ts tests/measurement.integration.test.ts"
  },
  "keywords": [
    "node",
    "express",
    "typescript",
    "api"
  ],
  "license": "MIT",
  "overrides": {
    "qs": "^6.16.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/cors": "^2.8.19",
    "argon2": "^0.45.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^8.0.1",
    "oxlint": "^1.75.0",
    "prisma": "^7.9.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
