DATABASE_URL="postgresql://ascend:ascend_dev_password@localhost:5432/ascend?schema=public"
JWT_ACCESS_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
JWT_ISSUER="ascend-api"
JWT_AUDIENCE="ascend-app"
# Comma-separated list of allowed browser origins (CORS).
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# --- Email (password reset) ---
# Cualquier SMTP gratis sirve: Gmail (App Password), Brevo, etc.
# Sin SMTP_USER/SMTP_PASS, los links de reset solo se loguean en consola.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="tu.cuenta@gmail.com"
# SMTP_PASS="aaaa bbbb cccc dddd"   (App Password de Gmail, sin espacios)
# SMTP_FROM="ASCEND <tu.cuenta@gmail.com>"

# --- Google Sign-In (Web/PWA; hides the button when absent) ---
# GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"
