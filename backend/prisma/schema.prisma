generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String               @unique @db.VarChar(255)
  passwordHash        String?              @map("password_hash")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  googleId            String?              @unique @map("google_id") @db.VarChar(255)
  fullName            String?              @map("full_name") @db.VarChar(255)
  bio                 String?
  avatarUrl           String?              @map("avatar_url")
  reminderEnabled     Boolean              @default(false) @map("reminder_enabled")
  reminderHour        Int?                 @map("reminder_hour")
  reminderMinute      Int?                 @map("reminder_minute")
  reminderTzOffsetMin Int?                 @map("reminder_tz_offset_min")
  bodyMeasurements    BodyMeasurement[]
  customExercises     Exercise[]           @relation("CustomExercises")
  passwordResetTokens PasswordResetToken[]
  posts               Post[]               @relation("Posts")
  postComments        PostComment[]        @relation("UserPostComments")
  postLikes           PostLike[]           @relation("PostLikes")
  pushSubscriptions   PushSubscription[]
  routines            Routine[]
  routineFolders      RoutineFolder[]
  sessions            Session[]
  following           UserFollow[]         @relation("UserFollowers")
  followers           UserFollow[]         @relation("UserFollowing")
  workouts            Workout[]

  @@map("users")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Exercise {
  id                       String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                     String                    @db.VarChar(255)
  description              String?
  targetMuscleGroups       String[]                  @default([]) @map("target_muscle_groups")
  equipment                String?                   @db.VarChar(255)
  instructions             String?
  mediaUrl                 String?                   @map("media_url")
  createdByUserId          String?                   @map("created_by_user_id") @db.Uuid
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime?                 @map("deleted_at")
  primaryMuscleGroups      String[]                  @default([]) @map("primary_muscle_groups")
  createdByUser            User?                     @relation("CustomExercises", fields: [createdByUserId], references: [id], onDelete: Cascade)
  routineExercises         RoutineExercise[]
  routineTemplateExercises RoutineTemplateExercise[]
  workoutExercises         WorkoutExercise[]

  @@index([equipment])
  @@index([createdByUserId])
  @@map("exercise")
}

model Routine {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  name             String            @db.VarChar(255)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  folderId         String?           @map("folder_id") @db.Uuid
  posts            Post[]
  folder           RoutineFolder?    @relation(fields: [folderId], references: [id])
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineExercises RoutineExercise[]
  workouts         Workout[]

  @@index([userId])
  @@index([folderId])
  @@map("routine")
}

model RoutineExercise {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routineId            String   @map("routine_id") @db.Uuid
  exerciseId           String   @map("exercise_id") @db.Uuid
  position             Int
  targetSets           Int?     @map("target_sets") @db.SmallInt
  targetRepetitionsMin Int?     @map("target_repetitions_min") @db.SmallInt
  targetRepetitionsMax Int?     @map("target_repetitions_max") @db.SmallInt
  targetWeight         Decimal? @map("target_weight") @db.Decimal(8, 2)
  restSeconds          Int?     @map("rest_seconds")
  notes                String?
  exercise             Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  routine              Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@unique([routineId, position])
  @@index([exerciseId])
  @@map("routine_exercise")
}

model RoutineTemplate {
  id          String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String                    @unique @db.VarChar(100)
  name        String                    @db.VarChar(255)
  description String                    @db.VarChar(1000)
  level       String                    @db.VarChar(50)
  goal        String                    @db.VarChar(50)
  equipment   String                    @db.VarChar(50)
  createdAt   DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  exercises   RoutineTemplateExercise[]

  @@index([level])
  @@index([goal])
  @@index([equipment])
  @@map("routine_template")
}

model RoutineTemplateExercise {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId           String          @map("template_id") @db.Uuid
  exerciseId           String          @map("exercise_id") @db.Uuid
  exerciseName         String          @map("exercise_name") @db.VarChar(255)
  position             Int
  targetSets           Int?            @map("target_sets") @db.SmallInt
  targetRepetitionsMin Int?            @map("target_repetitions_min") @db.SmallInt
  targetRepetitionsMax Int?            @map("target_repetitions_max") @db.SmallInt
  restSeconds          Int?            @map("rest_seconds")
  exercise             Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  template             RoutineTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([exerciseId])
  @@map("routine_template_exercise")
}

model Workout {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  routineId        String?           @map("routine_id") @db.Uuid
  status           String            @default("active") @db.VarChar(20)
  startedAt        DateTime          @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime?         @map("completed_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  posts            Post[]
  routine          Routine?          @relation(fields: [routineId], references: [id])
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutExercises WorkoutExercise[]

  @@index([userId, startedAt(sort: Desc)])
  @@index([userId, status])
  @@index([routineId])
  @@map("workout")
}

model WorkoutExercise {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workoutId  String       @map("workout_id") @db.Uuid
  exerciseId String       @map("exercise_id") @db.Uuid
  position   Int
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  sets       WorkoutSet[]
  exercise   Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  workout    Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@unique([workoutId, position])
  @@index([exerciseId])
  @@map("workout_exercise")
}

model WorkoutSet {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workoutExerciseId String          @map("workout_exercise_id") @db.Uuid
  setNumber         Int             @map("set_number") @db.SmallInt
  weight            Decimal?        @db.Decimal(8, 2)
  repetitions       Int?            @db.SmallInt
  rpe               Decimal?        @db.Decimal(3, 1)
  setType           String          @default("normal") @map("set_type") @db.VarChar(20)
  notes             String?
  isCompleted       Boolean         @default(false) @map("is_completed")
  completedAt       DateTime?       @map("completed_at") @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@unique([workoutExerciseId, setNumber])
  @@map("set")
}

model Session {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  refreshTokenHash String   @unique @map("refresh_token_hash")
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model PasswordResetToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_token")
}

model PushSubscription {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscription")
}

model RoutineFolder {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  name      String    @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  routines  Routine[]
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("routine_folder")
}

model BodyMeasurement {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  date      DateTime @db.Date
  weight    Decimal? @db.Decimal(5, 2)
  neck      Decimal? @db.Decimal(5, 2)
  shoulders Decimal? @db.Decimal(5, 2)
  chest     Decimal? @db.Decimal(5, 2)
  waist     Decimal? @db.Decimal(5, 2)
  hips      Decimal? @db.Decimal(5, 2)
  bicep     Decimal? @db.Decimal(5, 2)
  thigh     Decimal? @db.Decimal(5, 2)
  calf      Decimal? @db.Decimal(5, 2)
  bodyFat   Decimal? @map("body_fat") @db.Decimal(4, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("body_measurement")
}

model Post {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId  String        @map("author_id") @db.Uuid
  postType  String        @default("workout") @map("post_type") @db.VarChar(20)
  workoutId String?       @map("workout_id") @db.Uuid
  caption   String?
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  routineId String?       @map("routine_id") @db.Uuid
  author    User          @relation("Posts", fields: [authorId], references: [id], onDelete: Cascade)
  routine   Routine?      @relation(fields: [routineId], references: [id], onDelete: Cascade)
  workout   Workout?      @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  comments  PostComment[] @relation("PostComments")
  likes     PostLike[]

  @@index([authorId])
  @@index([workoutId])
  @@index([routineId])
  @@index([createdAt(sort: Desc)])
  @@map("post")
}

model PostLike {
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation("PostLikes", fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
  @@map("post_like")
}

model UserFollow {
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  follower    User     @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("user_follow")
}

model PostComment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  author    User     @relation("UserPostComments", fields: [authorId], references: [id], onDelete: Cascade)
  post      Post     @relation("PostComments", fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId])
  @@map("post_comment")
}
